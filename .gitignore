# ============================================
# DEBUGBI0 - .gitignore
# ============================================

# ---- Secretos / Configuracion sensible ----
.env
.env.*
!.env.example
config.ini
secrets.json
*.pem
*.key
*.crt
*.p12
*.pfx
id_rsa*
known_hosts

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
pip-log.txt
pip-delete-this-directory.txt
requirements-frozen.txt

# ---- Tests / Coverage ----
.pytest_cache/
.coverage
htmlcov/
.tox/

# ---- Bases de datos ----
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
webapp/*.db
instance/
*.bak
*.db.bak

# ---- Exports / Outputs (contienen PII) ----
data/outputs/*
!data/outputs/.gitkeep
output/
exports/
*.xlsx
*.xls
*.csv
*.zip

# ---- IDE ----
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject

# ---- Claude Code (per-machine, no compartir) ----
.claude/
.secret_key_dev
.fernet_salt_dev

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Logs ----
*.log
*.log.*
logs/

# ---- Flask ----
.webassets-cache
.flask_session/

# ---- Deployment ----
releases/
current
shared/
